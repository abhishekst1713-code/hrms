# Origin of the Flask API that receives the "Book a demo" form.
# Leave unset to post to the same origin as the site (correct when the site
# and the API sit behind one host). In `npm run dev` an unset value falls
# back to http://localhost:5050, the backend's default port.
#
#   VITE_API_URL=https://api.infopaceindia.com
VITE_API_URL=

# Note for whoever deploys this: the API's CORS allow-list must include the
# origin this site is served from. Set ALLOWED_ORIGINS in backend/.env, e.g.
#   ALLOWED_ORIGINS=https://infopaceindia.com,https://www.infopaceindia.com
