# Origin of the Flask API that receives the "Book a demo" form.
# Leave unset to post to the same origin as the site (correct when the site
# and the API sit behind one host). In `npm run dev` an unset value falls
# back to http://localhost:5050, the backend's default port.
#
#   VITE_API_URL=https://api.infopaceindia.com
# Only used by `npm run dev` now; production posts to its own /api.
VITE_API_URL=

# Note for whoever deploys this: the API's CORS allow-list must include the
# origin this site is served from. Set ALLOWED_ORIGINS in backend/.env, e.g.
#   ALLOWED_ORIGINS=https://infopaceindia.com,https://www.infopaceindia.com

# ---- Vercel project environment variables (Settings → Environment Variables)
# The "Book a demo" form posts to api/demo-requests.js, which writes straight
# to MongoDB. It needs the same connection string the Flask backend uses:
#   MONGO_URI=mongodb+srv://user:pass@cluster.example.mongodb.net/hr_offer_letters
# Optional, defaults to hr_offer_letters:
#   MONGO_DB=hr_offer_letters
#
# Once the lead is saved, the same function sends the confirmation and
# internal notification mail over SMTP — same values as backend/.env:
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   SMTP_USER=support@infopaceindia.com
#   SMTP_PASS=<app password>
#   EMAIL_FROM=Infopace <support@infopaceindia.com>
#   DEMO_NOTIFY_EMAIL=support@infopaceindia.com
# Leaving these unset just skips sending — the lead is still stored.
