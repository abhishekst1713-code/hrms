# Copy to .env and fill in real values. Never commit the real .env file.

MONGO_URI=mongodb://localhost:27017/hr_offer_letters

# Required in production — the app refuses to start without it there.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Where "Book a demo" enquiries from the marketing site are emailed.
# Falls back to SMTP_FROM, then SMTP_USER, if unset.
DEMO_NOTIFY_EMAIL=

# Comma-separated list of frontend origins allowed to call this API.
# The marketing site runs on its own origin, so add it here too or the
# browser will block the demo form's POST, e.g.
#   ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4173,https://infopaceindia.com
# Required in production. Example for multiple tenant frontends:
# ALLOWED_ORIGINS=https://app.example.com,https://acme.example.com
ALLOWED_ORIGINS=http://localhost:3000

# production | development — gates the JWT_SECRET_KEY/ALLOWED_ORIGINS checks above.
FLASK_ENV=development

# Required in production — encrypts uploaded KYC documents (Aadhaar, PAN,
# bank passbook) at rest in GridFS. Losing this key permanently loses
# access to every file encrypted with it, so back it up like any other
# production secret. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FILE_ENCRYPTION_KEY=

# Public-facing base URL of the frontend — used to build links in invite/
# password-reset emails (#/accept-invite, #/reset-password).
FRONTEND_URL=http://localhost:3000

# SMTP for invite/reset/notification emails (routes/auth.py,
# services/email_service.py). Falls back to returning the link in the API
# response when unset, so dev/demo environments still work without email.
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_PORT=587
SMTP_FROM=

# Optional — error tracking (observability.py). Only initializes if both
# this and the sentry-sdk package are present; omit to log errors locally only.
SENTRY_DSN=

# Optional — caps how many tenants' daily scheduler checks
# (birthday/anniversary emails) run concurrently. Default 8.
SCHEDULER_MAX_CONCURRENT_TENANTS=8
