# Copy to .env and fill in real values. Never commit the real .env file.

MONGO_URI=mongodb://localhost:27017/hr_offer_letters

# Required in production — the app refuses to start without it there.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Where "Book a demo" enquiries from the marketing site are emailed.
# Falls back to the send-as address (EMAIL_FROM, then SMTP_FROM/SMTP_USER).
DEMO_NOTIFY_EMAIL=

# Comma-separated list of frontend origins allowed to call this API.
# Required in production — the app refuses to start without it there, and the
# list is used exactly as written, so every origin that calls this API must be
# in it (the in-app frontend AND the marketing site, or the browser blocks the
# demo form's POST):
#   ALLOWED_ORIGINS=https://app.infopaceindia.com,https://infopaceindia.com
# Outside production the local dev servers (localhost/127.0.0.1 on 3000, 5173
# and 4173) are always allowed on top of whatever is set here, so you do not
# have to list them to work locally.
ALLOWED_ORIGINS=http://localhost:3000

# production | development — gates the JWT_SECRET_KEY/ALLOWED_ORIGINS checks above.
FLASK_ENV=development

# Required in production — encrypts uploaded KYC documents (Aadhaar, PAN,
# bank passbook) at rest in GridFS. Losing this key permanently loses
# access to every file encrypted with it, so back it up like any other
# production secret. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FILE_ENCRYPTION_KEY=

# Public-facing base URL of the frontend — used to build links in invite/
# password-reset emails (#/accept-invite, #/reset-password).
FRONTEND_URL=http://localhost:3000

# ── Email ────────────────────────────────────────────────────────────────
# Everything outbound (invites, password resets, demo-request confirmations,
# offer/relieving letters, birthday mail) goes through
# services/email_service.py, which has two transports.
#
# 1. A provider HTTP API. Set ONE key below plus EMAIL_FROM. This is the
#    only thing that works on a host that blocks outbound SMTP — Render
#    free instances do, and the symptom is exactly
#    "Email send failed: ... ([Errno 101] Network is unreachable)".
#    The sender address has to be verified with the provider first.
#    See EMAIL_SETUP.md.
RESEND_API_KEY=
BREVO_API_KEY=
SENDGRID_API_KEY=
EMAIL_FROM=

# Optional — force a transport when more than one is configured:
# resend | brevo | sendgrid | smtp. Unset picks the first key that is set,
# then SMTP.
EMAIL_PROVIDER=

# 2. SMTP. Used when no API key is set. Fine locally and on any host that
#    allows outbound 587/465. Where those are blocked (free Render), a relay
#    that listens on 2525 still works — SMTP_HOST=smtp-relay.brevo.com with
#    SMTP_PORT=2525, using the provider's SMTP credentials. Gmail has no
#    2525. `python scripts/test_email.py --probe` says which ports a host can
#    reach. Falls back to returning the invite link in the API response when
#    unset, so dev/demo environments still work without email at all.
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_PORT=587
SMTP_FROM=
SMTP_TIMEOUT=20

# Optional — unlocks GET /api/diagnostics/email and POST
# /api/diagnostics/email/test on the deployed instance, for hosts with no
# shell (Vercel). Send it as the X-Diagnostics-Token header. Leave it unset
# and those endpoints refuse everyone but a platform admin. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
DIAGNOSTICS_TOKEN=

# Optional — error tracking (observability.py). Only initializes if both
# this and the sentry-sdk package are present; omit to log errors locally only.
SENTRY_DSN=

# Optional — caps how many tenants' daily scheduler checks
# (birthday/anniversary emails) run concurrently. Default 8.
SCHEDULER_MAX_CONCURRENT_TENANTS=8
