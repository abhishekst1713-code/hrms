{
  "extends": ["react-app", "react-app/jest"],
  "plugins": ["react-hooks"],
  "rules": {
    "no-unused-vars": "off",
    "no-dupe-keys": "off",
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "off",
    "jsx-a11y/anchor-is-valid": "off",
    "jsx-a11y/iframe-has-title": "off"
  }
}
